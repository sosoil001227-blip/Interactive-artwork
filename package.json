{
  "name": "interactive-artwork",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "dev:example8": "npm run dev -- --open /example-8/",
    "dev:example9": "npm run dev -- --open /example-9/",
    "dev:example10": "npm run dev -- --open /example-10/",
    "dev:example11": "npm run dev -- --open /example-11/",
    "dev:example12": "npm run dev -- --open /example-12/",
    "dev:example13": "npm run dev -- --open /example-13/",
    "dev:example14": "npm run dev -- --open /example-14/",
    "build": "tsc --noEmit && tsc --project example-13/tsconfig.json && node scripts/prepare-worker.mjs && npm run build:example13-tracking && vite build && node scripts/compress-assets.mjs",
    "build:worker": "node scripts/prepare-worker.mjs",
    "build:example13-tracking": "node example-13/scripts/assets.mjs --shared",
    "optimize:images": "node scripts/optimize-theatre-images.mjs",
    "build:example9": "npm run build",
    "test": "node --test tests/*.test.* example-8/tests/*.test.ts example-9/tests/*.test.ts example-10/tests/*.test.ts example-11/tests/*.test.ts example-12/tests/*.test.ts example-13/tests/*.test.ts example-14/tests/*.test.ts",
    "preview": "vite preview --host localhost --port 5174 --strictPort",
    "setup": "npm install",
    "setup:example9": "npm install",
    "https:cert": "node scripts/dev-https.mjs",
    "https:trust": "node scripts/dev-https.mjs --trust",
    "postinstall": "node scripts/prepare-assets.mjs && npm run build:example13-tracking"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
